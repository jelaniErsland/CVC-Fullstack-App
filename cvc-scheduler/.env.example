# Safe for browser and server use. Obtain these from the Supabase project API settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# "review" keeps the current mock admin routes open. "enforced" requires a
# Supabase Auth session for admin routes other than the auth shell.
ADMIN_AUTH_MODE=review

# Trusted application origin used only by the unlinked server-side response-link diagnostic.
# Use http://127.0.0.1:3000 locally and an https origin in deployed environments.
RESPONSE_LINK_BASE_URL=

# Disabled by default. Initial assignment notification email uses a server-only
# transport and trusted origin. Use "recording" for deterministic local/QA, or
# "resend" only after the sender/domain, secret, canonical URL, and monitoring
# requirements in the production runbook are complete.
ASSIGNMENT_NOTIFICATION_EMAIL_TRANSPORT=
ASSIGNMENT_NOTIFICATION_BASE_URL=
ASSIGNMENT_NOTIFICATION_FROM=
ASSIGNMENT_NOTIFICATION_RECORDING_PATH=

# Required only when ASSIGNMENT_NOTIFICATION_EMAIL_TRANSPORT=resend.
# Server-only secret: never use NEXT_PUBLIC_, commit a real value, or expose it.
RESEND_API_KEY=

# Optional until a reviewed server-only operation explicitly requires it.
# Never add NEXT_PUBLIC_ to this name and never use it from browser code.
SUPABASE_SERVICE_ROLE_KEY=
